---
# ansible-lint reads this file too, so the yaml[...] entries in .ansible-lint
# and the rules here should agree. ansible-lint also requires the braces,
# comments, comments-indentation, and octal-values settings below, or it warns
# that the config is incompatible and turns off its fix mode. The truthy
# values are the ones ansible-lint uses by default.
extends: default

ignore:
  - .venv/
  - .ansible/

rules:
  # Allow `{ key: value }` with spaces inside the braces. These are also the
  # values ansible-lint requires.
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  colons: disable
  commas: disable
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  empty-lines: disable
  line-length: disable
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  trailing-spaces: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
